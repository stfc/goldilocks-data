.DS_Store
**/.DS_Store
.venv/
.venv-*/
.pytest_cache/
.ruff_cache/
**/__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Agent configuration is committed: .agents/ is the shared source and
# .claude/skills symlinks to it. CLAUDE.md stays local.
CLAUDE.md

# Historical working copies remain local; the curated notebook lives beside them.
campaigns/**/notebooks/archive/
.notebooks-orig-backup-*.tar.gz

# Local exploratory material and internal planning are not public artefacts.
/notebooks/
/docs/PLAN.md
/docs/PLAN.en.md
/site/

# Intermediate analysis caches are reproducible and can be large.
*.pkl

# The PseudoDojo working snapshot is regenerated every cycle from the AiiDA
# group in snapshot-metadata.json; only the small metadata stays tracked.
/campaigns/qe/kpoints/results/source-summary.csv
/campaigns/qe/kpoints/results/workchain-records.parquet
